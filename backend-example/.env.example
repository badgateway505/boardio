# Sumsub API Credentials
# Get these from your Sumsub dashboard: https://cockpit.sumsub.com/

# Your Sumsub App Token (X-App-Token header)
SUMSUB_APP_TOKEN=your_app_token_here

# Your Sumsub Secret Key (used for HMAC signature)
SUMSUB_SECRET_KEY=your_secret_key_here

# Server Port (optional, defaults to 3001)
PORT=3001
